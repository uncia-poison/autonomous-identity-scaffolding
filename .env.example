# AIS_* names are preferred; legacy ACS_* names are still accepted.
# Local runtime (Ollama native API)
AIS_MEMORY_ROOT=/mnt/gdrive/AIS/agent-memory
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434

# API runtime (OpenAI Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=

# Optional S3-compatible event store for the API runtime
AIS_S3_BUCKET=
AIS_S3_PREFIX=acs/agent-name
AIS_S3_ENDPOINT_URL=
AIS_LOCAL_INDEX_ROOT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
