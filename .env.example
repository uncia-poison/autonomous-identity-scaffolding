# Local runtime (Ollama native API)
ACS_MEMORY_ROOT=/mnt/gdrive/ACS/agent-memory
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434

# API runtime (OpenAI Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=

# Optional S3-compatible event store for the API runtime
ACS_S3_BUCKET=
ACS_S3_PREFIX=acs/agent-name
ACS_S3_ENDPOINT_URL=
ACS_LOCAL_INDEX_ROOT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
